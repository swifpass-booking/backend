# Local dev: DJANGO_DEBUG=1 enables throwaway fallback secrets.
DJANGO_DEBUG=1
# Production: set all of these; generate secrets with
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
JWT_SECRET=
DJANGO_ALLOWED_HOSTS=api.example.com
# Roles are authorized by OpenFGA. Run `manage.py openfga_setup` then `openfga_sync` after it is up.
OPENFGA_API_URL=http://localhost:8080
OPENFGA_API_TOKEN=
CORS_ALLOWED_ORIGINS=https://app.example.com
