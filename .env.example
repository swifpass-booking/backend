# Local dev: DJANGO_DEBUG=1 enables throwaway fallback secrets.
DJANGO_DEBUG=1
# Production: set all of these; generate secrets with
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
JWT_SECRET=
DJANGO_ALLOWED_HOSTS=api.example.com
# Roles are authorized by OpenFGA. Run `manage.py openfga_setup` after it is up, then create_admin / grant_staff
# (revoke_access removes rights). openfga_sync is a one-time import of the old User.role column: run it by hand, never on boot.
OPENFGA_API_URL=http://localhost:8080
OPENFGA_API_TOKEN=
CORS_ALLOWED_ORIGINS=https://app.example.com

# Number of reverse proxies in front of gunicorn (Render: 1). Rate limits key on the real client address with it;
# leave 0 only when nothing sits in front.
TRUSTED_PROXY_HOPS=1
DJANGO_SSL_REDIRECT=1
# Where the browser comes back to after paying (the web app's origin).
FRONTEND_BASE_URL=https://app.example.com
# Payment gateways (sandbox by default). eSewa and Fonepay publish test merchants for local dev; Khalti needs your own key.
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET_KEY=
# Bootstraps the first admin on boot (password only when the account does not exist yet).
ADMIN_IDENTIFIER=
ADMIN_PASSWORD=
# Optional: your own OSRM server for bus routes (the public demo server is for development only).
OSRM_BASE_URL=
